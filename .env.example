# meta_server 환경변수 예제
# 복사해서 사용: cp .env.example .env

# === 서버 ===
# bind address
BIND_ADDR=0.0.0.0:3000

# === 데이터베이스 ===
# memory | postgres | pgsql | sql | database
DATABASE_BACKEND=memory
# PostgreSQL connection string (DATABASE_BACKEND=postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/meta

# === Redis (L2 cache) ===
# true | false
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# === JWT 인증 ===
# false: JWT 미검증 (개발 모드)
JWT_DISABLED=false
# HS256 secret (적어도 32자)
JWT_SECRET=change-me-to-32-chars-minimum
# issuer
JWT_ISSUER=meta-server
# token lifetime seconds
JWT_TTL_SECONDS=3600

# === Rate Limiting ===
# 요청/분 (0 = 비활성)
RATE_LIMIT_PER_MIN=100

# === Admin API 인증 ===
# X-Admin-Token 헤더 값 (빈 값: 인증 우회, 개발 모드)
ADMIN_TOKEN=

# === CORS ===
# 허용 origin (콤마 구분, 빈 값: * )
CORS_ORIGINS=

# === WebSocket Socket.IO ===
# 최대 동시 세션 수
SOCKET_MAX_SESSIONS=10000

# === Observability ===
# 로깅 레벨
RUST_LOG=info
